# x' = 1 has no steady state
SOLVER CSSS
STARTING_TIME 0.0
ENDING_TIME 1.0
RELATIVE_TOLERANCE 1.0E-9
ABSOLUTE_TOLERANCE 1.0E-12
STEADY_STATE TRUE
RESOLUTION 1e-9
MAX_NEWTON_ITERATIONS 50
MAXIMUM_FORWARD_DURATION 1e3
DERIVATION_FACTOR 0.001
STOP_CRITERIA DISTANCE_AND_RATE
NUM_EQUATIONS 1
ODE x INIT 0.0;
	 RATE 1.0;
