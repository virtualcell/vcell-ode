# A + B <-> C with conserved totals A + C = 1 and B + C = 2 left in the ODEs (issue #15); steady state C = 2 - sqrt(2)
SOLVER CSSS
STARTING_TIME 0.0
ENDING_TIME 1.0
RELATIVE_TOLERANCE 1.0E-9
ABSOLUTE_TOLERANCE 1.0E-12
STEADY_STATE TRUE
RESOLUTION 1e-9
MAX_NEWTON_ITERATIONS 50
MAXIMUM_FORWARD_DURATION 1e9
DERIVATION_FACTOR 0.001
STOP_CRITERIA DISTANCE_AND_RATE
NUM_EQUATIONS 3
ODE A INIT 1.0;
	 RATE ((-1.0 * A * B) + C);
ODE B INIT 2.0;
	 RATE ((-1.0 * A * B) + C);
ODE C INIT 0.0;
	 RATE ((A * B) - C);
