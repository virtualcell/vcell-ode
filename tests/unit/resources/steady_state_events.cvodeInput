# Event at t = 5 raises the production rate k from 1 to 2; Newton disabled so the event must fire during integration
SOLVER CSSS
STARTING_TIME 0.0
ENDING_TIME 1.0
RELATIVE_TOLERANCE 1.0E-9
ABSOLUTE_TOLERANCE 1.0E-12
STEADY_STATE TRUE
RESOLUTION 1e-9
MAX_NEWTON_ITERATIONS 0
MAXIMUM_FORWARD_DURATION 1e9
DERIVATION_FACTOR 0.001
STOP_CRITERIA DISTANCE_AND_RATE
DISCONTINUITIES 1
D_B0 (t >= 5.0); (-5.0 + t);
EVENTS 1
EVENT raise_k
TRIGGER (D_B0 == 1.0);
EVENTASSIGNMENTS 1
0 2.0;
NUM_EQUATIONS 2
ODE k INIT 1.0;
	 RATE 0.0;
ODE x INIT 0.0;
	 RATE (k - x);
