# Nonlinear chain; steady state reachable by Newton from the initial condition
SOLVER CSSS
STARTING_TIME 0.0
ENDING_TIME 1.0
RELATIVE_TOLERANCE 1.0E-9
ABSOLUTE_TOLERANCE 1.0E-12
STEADY_STATE TRUE
RESOLUTION 1e-9
MAX_NEWTON_ITERATIONS 50
MAXIMUM_FORWARD_DURATION 1e9
DERIVATION_FACTOR 0.001
STOP_CRITERIA DISTANCE_AND_RATE
NUM_EQUATIONS 3
ODE S INIT 0.0;
	 RATE (10.0 - ((5.0 * S) / (1.0 + S)) - (0.1 * S));
ODE E INIT 1.0;
	 RATE (((5.0 * S) / (1.0 + S)) - (2.0 * E));
ODE P INIT 0.0;
	 RATE ((2.0 * E) - (0.5 * P * P));
