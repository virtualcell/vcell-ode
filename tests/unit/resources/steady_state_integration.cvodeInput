# Brusselator (A=1, B=2) with Newton disabled up front, forcing the forward-integration path
SOLVER CSSS
STARTING_TIME 0.0
ENDING_TIME 1.0
RELATIVE_TOLERANCE 1.0E-9
ABSOLUTE_TOLERANCE 1.0E-12
STEADY_STATE TRUE
RESOLUTION 1e-9
MAX_NEWTON_ITERATIONS 0
MAXIMUM_FORWARD_DURATION 1e9
DERIVATION_FACTOR 0.001
STOP_CRITERIA DISTANCE_AND_RATE
NUM_EQUATIONS 2
ODE X INIT 0.5;
	 RATE (1.0 - (2.0 * X) + (X * X * Y));
ODE Y INIT 3.0;
	 RATE (X - (X * X * Y));
